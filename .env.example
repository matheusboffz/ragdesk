# =============================================================================
# RAGDesk - Environment Configuration Example
# Copy this file to .env: cp .env.example .env
# NEVER commit your real .env file or API keys to version control.
# =============================================================================

# --- Application Settings ---
APP_NAME=RAGDesk
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL + pgvector Database ---
POSTGRES_USER=ragdesk
POSTGRES_PASSWORD=ragdesk_dev_password
POSTGRES_DB=ragdesk
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ragdesk:ragdesk_dev_password@db:5432/ragdesk

# --- JWT Authentication & Security ---
JWT_SECRET_KEY=replace-with-a-secure-random-256-bit-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- AI Providers (Configurable: mock | gemini | openai) ---
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
EMBEDDING_DIMENSION=768

# Google Gemini Configuration (used when LLM_PROVIDER=gemini or EMBEDDING_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI Configuration (used when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG Pipeline & Fallback Guardrails ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.65
CHAT_HISTORY_WINDOW=6

# --- Upload & Rate Limiting ---
MAX_UPLOAD_SIZE_MB=10
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
